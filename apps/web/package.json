{
  "name": "@nyrvexa/web",
  "version": "0.1.0",
  "private": true,
  "description": "Nyrvexa web client — PixiJS hex map + React HUD.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5175",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nyrvexa/content": "workspace:*",
    "@nyrvexa/engine": "workspace:*",
    "@nyrvexa/protocol": "workspace:*",
    "pixi.js": "^8.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
